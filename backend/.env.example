DATABASE_URL=mysql://root:YOUR_PASSWORD@127.0.0.1:3306/oncredsync
HOST=127.0.0.1
PORT=8080
RUST_LOG=oncredsync_backend=info,tower_http=info
FRONTEND_ORIGIN=http://localhost:5173

# Future EVM integration (do not commit secrets)
# CHAIN_ID=84532
# RPC_URL=
# POLICY_CONTRACT_ADDRESS=
# SIGNER_PRIVATE_KEY=
# X402_FACILITATOR_URL=

# Authentication (required). Generate a unique random secret of 32+ characters.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# First-run bootstrap only: create the initial Super Admin account. Keep these values private.
BOOTSTRAP_ADMIN_NAME=Platform Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@your-company.example
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
